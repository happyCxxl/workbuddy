<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy</artifactId>
        <version>5.1.0</version>
    </parent>

    <artifactId>workbuddy-auth</artifactId>
    <name>workbuddy-auth</name>
    <packaging>jar</packaging>
    <description>认证与用户：登录/注册、用户表、令牌、安全配置</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-infra</artifactId>
        </dependency>
        <!-- 文件服务：头像上传与读取走对象存储端口（FileStorage） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-file</artifactId>
        </dependency>

        <!-- Web 过滤链基类（OncePerRequestFilter）：接口层已收拢到 biz，
             本模块不再声明 Web 起步依赖，Servlet 容器由 biz 提供 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- servlet API：过滤链与两个安全处理器收了 servlet 类型，编译期需要；
             容器在 biz，运行期由它提供（与 common 同口径） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 安全框架（过滤链 + BCrypt） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT 令牌（与项目 hutool 版本对齐） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-jwt</artifactId>
            <version>5.8.22</version>
        </dependency>

        <!-- 配置属性元数据（生成 META-INF/spring-configuration-metadata.json，IDE 按它解析本模块的键；
             optional：不进依赖方的运行时类路径） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
