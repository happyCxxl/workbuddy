<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy</artifactId>
        <version>5.1.0</version>
    </parent>

    <artifactId>workbuddy-biz</artifactId>
    <name>workbuddy-biz</name>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 配置属性元数据（生成 META-INF/spring-configuration-metadata.json，IDE 按它解析本模块的键；
             optional：不进依赖方的运行时类路径） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus（Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 数据库连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>

        <!-- Redis（任务唤醒队列与补偿锁） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 运维与指标：/actuator/health 健康探针、/actuator/metrics 读池指标（ThreadPoolTaskExecutor 自动打点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- hutool 工具类（平台标准，版本与平台 BOM hutool.version 一致） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>5.8.22</version>
        </dependency>

        <!-- hutool JSON：5.8 起从 core 拆出；审计摘要序列化用，LocalDateTime 经 JSONConfig.setDateFormat 输出可读时间 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
            <version>5.8.22</version>
        </dependency>

        <!-- 本项目模块 -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-infra</artifactId>
        </dependency>

        <!-- 文件服务模块（提交校验开流与元数据来源） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-file</artifactId>
        </dependency>

        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-worker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-model</artifactId>
        </dependency>

        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-auth</artifactId>
        </dependency>

        <!-- 任务重试 -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                核心链路所在模块：覆盖率门槛提到 90%（COMMON-TEST-07、JAVA-TEST-009）。
                本模块承载业务用例服务（写库与状态迁移），属核心链路。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>INSTRUCTION</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.90</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            变异测试（COMMON-TEST-12、JAVA-TEST-011）：默认不激活，按需执行
            mvn -pl workbuddy-biz -Pmutation pitest:mutationCoverage
            存活变异逐条评估：补用例，或说明该变异不改变行为。
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.15.8</version>
                        <configuration>
                            <targetClasses>
                                <param>com.workbuddy.biz.service.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.workbuddy.biz.*</param>
                            </targetTests>
                            <outputFormats>
                                <param>XML</param>
                                <param>HTML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <junit5PluginVersion>1.2.1</junit5PluginVersion>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
