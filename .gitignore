# 构建产物
target/
*.class

# 中间产物（构建、检查、命令输出的临时文件）：仓库只放源码、配置、规范与测试数据
*-out.txt
*.log
*.exec
*.tmp
*.bak
*.orig
*.rej
*.swp
*~

# 本地运行日志（仅根目录；源码包里如有同名目录不受影响）
/logs/

# 本地运行时数据（解析等环节产物，不入库；仅根目录——
# 注意：不锚定会误伤源码中任意层级的 common 包目录（如 com.youzhicai.common））
/common/

# 本地产物目录（knowledge.artifact.storage=local 默认 ./data/artifacts；仅根目录）
/data/

# Docker 数据卷（MySQL/Redis/Milvus 持久化数据，不入库）
docker/volumes/

# IntelliJ IDEA（整目录不入库）
.idea/
*.iml
*.ipr
*.iws

# 设计插件工作草稿区（deepseek-idesign 在根目录生成，不入库；仅根目录）
/design/

# 操作系统
.DS_Store
Thumbs.db
/knowledge-biz/data/
/.archify/
/samples/

# 本地密钥配置（真实密钥不入库；文件名固定，缺失时该 profile 的键不存在，
# 由 config/workbuddy-model.yml 的 ${ENV_VAR:} 空默认回落，交给启动期校验报错）
application-local.*

# AI 代理的个人本地偏好（团队共享规范在 AGENTS.md / web/AGENTS.md，个人偏好不入库）
AGENTS.local.md
CLAUDE.local.md

# Python 项目（虚拟环境、字节码与构建产物，任何层级）
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
