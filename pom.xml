<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 统一以官方 spring-boot-starter-parent 管理依赖版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.workbuddy</groupId>
  <artifactId>workbuddy</artifactId>
  <version>5.1.0</version>
  <name>workbuddy</name>
  <packaging>pom</packaging>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.5</mybatis-plus.version>
    <druid.version>1.2.23</druid.version>
    <milvus.version>2.5.5</milvus.version>
    <minio.version>8.5.12</minio.version>
    <bucket4j.version>8.20.0</bucket4j.version>
    <langchain4j.version>1.22.0</langchain4j.version>
    <resilience4j.version>2.1.0</resilience4j.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <jackson-annotations.version>2.22</jackson-annotations.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-biz</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-worker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-file</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy-vector</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- LangChain4j 官方 BOM（knowledge-model 的模型供应商调用，版本单点钉版）；
           只导官方线，不引 community 模块 -->
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-bom</artifactId>
        <version>${langchain4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 严格 JSON Schema 校验（模型输出结构校验，版本单点钉版） -->
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>

      <!-- Resilience4j 熔断器核心（模型级健康判定，版本单点钉版）；
           只引 circuitbreaker 模块，不引 spring-boot3 starter —— 装配点在本工程内，
           starter 会把版本与本工程的 Boot 3.2.5 绑在一起，其自动装配也不参与本工程的健康判定 -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-circuitbreaker</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>

      <!-- 统一钉版：json-schema-validator 3.0.8 传递 tools.jackson.core:jackson-databind 3.2.1，
           该库类初始化要读 com.fasterxml.jackson.annotation.JsonSerializeAs（2.16 起才有），
           Boot 3.2.5 管理的 jackson-annotations 2.15.4 内无此类，
           调 SchemaRegistry.getSchema(...) 即抛 NoClassDefFoundError: JsonSerializeAs；
           仅提注解版本，databind 与 core 仍随 Boot 保持 2.15.4 -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson-annotations.version}</version>
      </dependency>

      <!-- MinIO Java SDK（knowledge-file-center 对象存储实现，版本钉版） -->
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>

      <!-- Bucket4j（注解式限流的令牌桶实现；jdk17 线匹配本工程 Java 21，
           lettuce 版复用工程已有的 Lettuce 客户端，不引入第二个 Redis 客户端） -->
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j_jdk17-core</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j_jdk17-lettuce</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>

      <!-- MyBatis-Plus（平台钉版 3.5.4 与 Boot 3.2/Spring 6.1 有两处已知不兼容：
           factoryBeanObjectType、ddlApplicationRunner NullBean，升级 3.5.5 修复；Boot 3 环境用 spring-boot3-starter） -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-annotation</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>

      <!-- mybatis-spring 显式钉版（3.5.5 起自带 3.0.3；防御传递版本漂移） -->
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis-spring</artifactId>
        <version>3.0.3</version>
      </dependency>

      <!-- Druid 连接池（Boot 3 专用 starter） -->
      <dependency>
        <groupId>com.alibaba</groupId>
        <artifactId>druid-spring-boot-3-starter</artifactId>
        <version>${druid.version}</version>
      </dependency>

      <!-- Milvus 官方 SDK（worker 直接依赖 io.milvus.*，版本钉版） -->
      <dependency>
        <groupId>io.milvus</groupId>
        <artifactId>milvus-sdk-java</artifactId>
        <version>${milvus.version}</version>
      </dependency>

      <!-- 统一钉版：Tika 3.1.0 要求 commons-compress 1.27.x；平台 easyexcel(3.1.1)→POI 4.1.2
           传递的 1.21 更近会覆盖，导致运行时 ZipArchiveInputStream.getNextEntry() NoSuchMethodError -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.27.1</version>
      </dependency>

      <!-- 统一钉版：Tika 3.1.0 的 OOXML 深层探测（OPCPackageDetector）依赖 POI 5.4.0 + xmlbeans；
           平台 easyexcel(3.1.1) 传递的 POI 4.1.2 更近会顶掉 5.4.0 且 xmlbeans 缺失，
           深层探测加载失败（NoClassDefFoundError: org.apache.xmlbeans.XmlObject）后 Tika 静默降级，
           标准 docx 被误判为 application/x-tika-ooxml / application/zip -->
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi</artifactId>
        <version>5.4.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>5.4.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-scratchpad</artifactId>
        <version>5.4.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml-lite</artifactId>
        <version>5.4.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.xmlbeans</groupId>
        <artifactId>xmlbeans</artifactId>
        <version>5.3.0</version>
      </dependency>

      <!-- 统一钉版：PDFBox 3.0.4 为 Tika 3.1.0 实测传递版本（设计 9.5.3 示例 3.0.5 为占位），
           文档解析环节直接调用 PDFBox API（worker 提升为直接依赖），与 Tika 传递版对齐避免二次冲突 -->
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>3.0.4</version>
      </dependency>

      <!-- 统一钉版：milvus-sdk-java 2.5.5（经 common-milvus 传递）按 protobuf-java 3.24.0
           生成代码（调用 LazyStringArrayList.emptyList() 公开方法）；平台传递的 3.21.9 运行时
           IllegalAccessError（该方法非 public）导致 MilvusClientV2 启动失败 -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>3.24.0</version>
      </dependency>
    </dependencies>

  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 静态检查插件版本钉版：verify 阶段作为交付自检门禁 -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>4.8.6.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>3.4.0</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>10.14.2</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>3.26.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        显式打开注解处理，消掉 JDK 21 起 javac 的「隐式启用注解处理」告警：
        classpath 上能找到处理器（本项目是 Lombok，未配 annotationProcessorPaths），
        但没显式声明 —— 未来的 JDK 可能默认关掉这种隐式处理，告警文本给出的解法之一
        就是 -proc:full（= JDK 21 及以前的行为），行为不变、只消告警。

        两点必须这样写：① 只能显式配插件，不能写成属性 —— maven-compiler-plugin 3.12.1
        的 proc 没有 user property（release 同理，各模块才各自手写 <release>21</release>），
        写成属性会被静默忽略；② 放在 <build><plugins> 而不是 pluginManagement ——
        后者到不了没声明该插件的模块（本项目 9 个模块里只有 6 个声明了它）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
        </configuration>
      </plugin>
      <!-- 源码风格检查：规则集与存量代码风格对齐，规则文件在 tools/backend/checkstyle.xml -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/tools/backend/checkstyle.xml</configLocation>
          <failOnViolation>true</failOnViolation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 源码静态分析：未使用成员/参数/局部变量（check 拦截）+ 重复代码（cpd-check 拦截） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <rulesets>
            <ruleset>${maven.multiModuleProjectDirectory}/tools/backend/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <!--
            阈值 45：cpd-check 没有 minimumTokens 参数，阈值只有 cpd 读得到，因此必须配在插件级
            （写进 cpd-check 的 execution 会被忽略、IDE 还会报 "Element minimumTokens is not
            allowed here"）。
          -->
          <minimumTokens>45</minimumTokens>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
          <execution>
            <id>cpd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>cpd-check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 字节码 bug 模式检查：交付自检口径为 Low（全量告警已清零或评审豁免，见 spotbugs-exclude.xml；
           Low 阈值可拦截新类漏 serialVersionUID / 漏 Locale 等低级告警） -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/tools/backend/spotbugs-exclude.xml</excludeFilterFile>
          <threshold>Low</threshold>
          <effort>Max</effort>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>workbuddy-infra</module>
    <module>workbuddy-common</module>
    <module>workbuddy-file</module>
    <module>workbuddy-auth</module>
    <module>workbuddy-model</module>
    <module>workbuddy-vector</module>
    <module>workbuddy-worker</module>
    <module>workbuddy-biz</module>
  </modules>

  <profiles>
    <!--
      run-tests：仅本地/手动验证单元测试时激活（mvn ... -Prun-tests）。
      企业父 pom 默认对 maven-compiler-plugin 的 default-testCompile 硬编码 skip=true（跳过测试编译），
      且父 pom 继承的 surefire 2.12.4 不支持 JUnit 5；本 profile 覆盖为 skip=false 并升级 surefire 3.x
      以便编译并运行 src/test 下的 Jupiter 单测。默认不激活，不影响常规打包构建。
    -->
    <profile>
      <id>run-tests</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <id>default-testCompile</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>testCompile</goal>
                </goals>
                <configuration>
                  <skip>false</skip>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>