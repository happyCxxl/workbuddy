#!/bin/sh
set -e
# pre-commit：对暂存文件做就地格式化（format-md 与 lint-staged 的 fix 结果回写索引），秒级返回。
# 验证类检查（注释口径、前端全量 lint、后端门禁）在 pre-push。
#
# 路径一律取 core.quotePath=false：保证中文名文件的 \.md$ 后缀匹配有效。
staged=$(git -c core.quotePath=false diff --cached --name-only)

# 格式器自检：暂存了格式器本身时先验证它仍然健康（改坏它会在提交时被明确拦下）。
if echo "$staged" | grep -qE '^\.agent/tools/format-md\.ps1$'; then
  powershell -NoProfile -ExecutionPolicy Bypass -File .agent/tools/format-md.ps1 -SelfTest
fi

if echo "$staged" | grep -q '\.md$'; then
  # 已删除的文件不进列表：文件不存在会让 Resolve-Path 报错，配合 set -e 会中断提交。
  # 末尾 || true：只删了 .md 时 grep 无匹配返回 1，否则 set -e 会中断提交。
  md=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)
  if [ -n "$md" ]; then
    paths=$(echo "$md" | sed "s/^/'/;s/\$/'/" | tr '\n' ',' | sed 's/,$//')
    powershell -NoProfile -ExecutionPolicy Bypass -Command "& ./.agent/tools/format-md.ps1 -Paths $paths"
    echo "$md" | while read -r f; do git add -- "$f"; done
  fi
fi

# 前端组：对暂存文件做自动修复（prettier / eslint / stylelint 的 fix 结果回写索引）。
# 全量检查（vue-tsc / ls-lint / 命名词表 / 规范合规）在 pre-push。
if echo "$staged" | grep -qE '^(web|\.agent/tools/frontend)/'; then
  (
    cd "$(git rev-parse --show-toplevel)/web"
    pnpm exec lint-staged --concurrent false
  )
fi
