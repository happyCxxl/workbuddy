#!/bin/sh
set -e
# pre-commit：对暂存文件做就地格式化（format-md 与 lint-staged 的 fix 结果回写索引），秒级返回。
# 验证类检查（注释口径、前端全量 lint、后端门禁）在 pre-push。
#
# 路径一律取 core.quotePath=false：保证中文名文件的 \.md$ 后缀匹配有效。
staged=$(git -c core.quotePath=false diff --cached --name-only)

# 格式器自检：暂存了格式器本身时先验证它仍然健康（改坏它会在提交时被明确拦下）。
if echo "$staged" | grep -qE '^\.agent/tools/common/format-md\.ps1$'; then
  powershell -NoProfile -ExecutionPolicy Bypass -File .agent/tools/common/format-md.ps1 -SelfTest
fi

if echo "$staged" | grep -q '\.md$'; then
  # 已删除的文件不进列表：文件不存在会让 Resolve-Path 报错，配合 set -e 会中断提交。
  # 末尾 || true：只删了 .md 时 grep 无匹配返回 1，否则 set -e 会中断提交。
  md=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)
  if [ -n "$md" ]; then
    paths=$(echo "$md" | sed "s/^/'/;s/\$/'/" | tr '\n' ',' | sed 's/,$//')
    powershell -NoProfile -ExecutionPolicy Bypass -Command "& ./.agent/tools/common/format-md.ps1 -Paths $paths"
    echo "$md" | while read -r f; do git add -- "$f"; done
  fi
fi

# 前端组：对暂存文件做自动修复（prettier / eslint / stylelint 的 fix 结果回写索引）。
# 全量检查（vue-tsc / ls-lint / 命名词表 / 规范合规）在 pre-push。
# 前端目录按「含 lint 脚本的 package.json」自动定位（仓库根或一级子目录），不写死目录名。
root=$(git rev-parse --show-toplevel)
frontend=''
for pkg in "$root"/package.json "$root"/*/package.json; do
  [ -f "$pkg" ] || continue
  grep -q '"lint"' "$pkg" 2>/dev/null || continue
  frontend=${pkg%/package.json}
  frontend=${frontend#"$root"}
  frontend=${frontend#/}
  [ -n "$frontend" ] || frontend='.'
  break
done
if [ -n "$frontend" ]; then
  if [ "$frontend" = '.' ]; then
    staged_fe=$(echo "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|vue|css|scss|less|html|json)$' || true)
  else
    staged_fe=$(echo "$staged" | grep -E "^(${frontend}/|\.agent/tools/vue/)" || true)
  fi
  if [ -n "$staged_fe" ]; then
    (
      cd "$root/$frontend"
      pnpm exec lint-staged --concurrent false
    )
  fi
fi

# 档案同步：代码变动必须同提交更新对应档案（配对见 .project/archive/config.json）
if [ -d .project ]; then
  node .project/tools/sync.mjs --gate || exit 1
fi
