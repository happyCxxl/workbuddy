<?xml version="1.0" encoding="UTF-8"?>

<!-- SpotBugs 排除清单：以下豁免均有评审口径，逐条说明 -->
<!-- 判空口径：项目统一走 NullUtil（参数可空注解的内部实现转发 Hutool），空指针类告警不再需要按方法豁免；
     新增代码遇到 NP_* 告警时改判空写法，不要往本清单加条目 -->
<FindBugsFilter>
    <!-- JAVA-DTO-006：DTO/Bean 只承载字段（可变字段与 Lombok 风格一致），防御性拷贝与 Lombok 风格冲突且无实际收益，整体豁免 EI_EXPOSE_REP/REP2 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- JAVA-ERR-004：任务链与解析器统一捕获 Exception 归一化错误码（捕获后转码），捕获范围即调用边界，豁免 REC_CATCH_EXCEPTION -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
    <!-- JAVA-ERR-002：SpillBuffer 构造期 SHA-256 算法探测失败即抛属内部缺陷 fail-fast（JDK 必有该算法），豁免 CT_CONSTRUCTOR_THROW -->
    <Match>
        <Class name="com.workbuddy.worker.input.SpillBuffer"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- JAVA-DTO-003：分页查询 DTO 的页码兜底，字段由 Spring 数据绑定器反射写入、不靠构造器初始化；
         判空统一走 NullUtil（内部转发 Hutool），SpotBugs 不识别其 null 语义，
         把紧随其后的拆箱比较 current < 1 判成"未初始化字段被解引用"。
         判空语义与原生 null 比较运行期等价，且 || 短路保证解引用时必非空。
         注意：该告警的主元素是**字段**，用 <Method> 限定匹配不上，必须按字段豁免 -->
    <Match>
        <Class name="com.workbuddy.common.dto.request.page.PageQueryDTO"/>
        <Field name="current"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>
    <Match>
        <Class name="com.workbuddy.common.dto.request.page.PageQueryDTO"/>
        <Field name="size"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>
    <!-- COMMON-ANTI-05：图片字节字段由使用方写入、不靠构造器初始化；判空统一走 NullUtil，
         SpotBugs 不识别其 null 语义，把 isNotNull 之后的 length 访问判成"未初始化字段被解引用"。
         判空语义与原生 null 比较运行期等价，且 && 短路保证解引用时必非空。 -->
    <Match>
        <Class name="com.workbuddy.common.domain.model.vision.VisionRequest"/>
        <Method name="hasBytes"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>
</FindBugsFilter>
