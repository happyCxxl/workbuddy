{
  "name": "knowledge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "知识库前端（自用单体，界面纯中文）",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:format && pnpm lint:js && pnpm lint:types && pnpm lint:css && pnpm lint:files && pnpm lint:names && pnpm lint:spec && pnpm lint:table",
    "lint:format": "prettier --check .",
    "lint:js": "eslint .",
    "lint:types": "vue-tsc -b",
    "lint:css": "stylelint \"**/*.{css,vue}\" --allow-empty-input",
    "lint:files": "ls-lint",
    "lint:names": "node ../.agent/tools/frontend/check-naming.mjs",
    "lint:spec": "node ../.agent/tools/frontend/check-spec.mjs",
    "lint:table": "node ../.agent/tools/frontend/check-table.mjs",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,mjs,ts,vue}": "eslint --fix",
    "*.{css,vue}": "stylelint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "axios": "^1.20.0",
    "docx-preview": "^0.4.1",
    "element-plus": "^2.14.6",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "xlsx": "^0.18.5"
  }
}
