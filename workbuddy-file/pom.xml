<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy</artifactId>
        <version>5.1.0</version>
    </parent>

    <artifactId>workbuddy-file</artifactId>
    <name>workbuddy-file</name>
    <packaging>jar</packaging>
    <description>文件服务模块：上传/下载、文件档案库（file_center 库）、内容寻址对象存取（MinIO 后端可替换）</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 领域模型与通用契约（FileMetadata/FileReference/R） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-common</artifactId>
        </dependency>

        <!-- 数据访问基类（InfraBaseMapper / InfraDbService / InfraDbServiceImpl） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-infra</artifactId>
        </dependency>

        <!-- MyBatis-Plus（档案表持久化；版本与根 pom mybatis-plus.version 对齐） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MinIO 对象存储（版本由根 pom 钉版） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- 上传/下载接口的 Web 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 单元测试（JUnit5 + Mockito） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
