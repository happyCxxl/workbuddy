<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.workbuddy</groupId>
        <artifactId>workbuddy</artifactId>
        <version>5.1.0</version>
    </parent>

    <artifactId>workbuddy-worker</artifactId>
    <name>workbuddy-worker</name>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-common</artifactId>
        </dependency>

        <!-- 文件服务模块（校验开流与元数据来源） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-file</artifactId>
        </dependency>

        <!-- 模型能力模块（向量化模型网关与目录） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-model</artifactId>
        </dependency>

        <!-- 基础设施模块（含 Milvus 客户端/集合/查询封装） -->
        <dependency>
            <groupId>com.workbuddy</groupId>
            <artifactId>workbuddy-infra</artifactId>
        </dependency>

        <!-- Spring 基础（注解 / 配置属性 / 条件装配） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Web 基础（MultipartFile 等） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Apache Tika 3.1.0（格式识别 + 损坏/加密探测；与解析环节共用同一套依赖） -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- 解析环节原生解析直接依赖（显式提升；版本由根 pom 钉版）：
             PDFBox 3.0.4（PDF 文本+坐标）、POI 5.4.0（Office 结构）、
             poi-scratchpad 5.4.0（HWPF 二进制 DOC） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 配置属性元数据（生成 META-INF/spring-configuration-metadata.json，IDE 按它解析本模块的键；
             optional：不进依赖方的运行时类路径） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                核心链路所在模块：覆盖率门槛提到 90%（COMMON-TEST-07、JAVA-TEST-009）。
                本模块承载流水线各环节的编排与降级判定，属核心链路。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>INSTRUCTION</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.90</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            变异测试（COMMON-TEST-12、JAVA-TEST-011）：默认不激活，按需执行
            mvn -pl workbuddy-worker -Pmutation pitest:mutationCoverage
            存活变异逐条评估：补用例，或说明该变异不改变行为。
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.15.8</version>
                        <configuration>
                            <targetClasses>
                                <param>com.workbuddy.worker.embedding.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.workbuddy.worker.embedding.*</param>
                            </targetTests>
                            <outputFormats>
                                <param>XML</param>
                                <param>HTML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <junit5PluginVersion>1.2.1</junit5PluginVersion>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>